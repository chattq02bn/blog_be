generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum MailStatus {
  PENDING
  SENT
  FAILED
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String
  name         String?
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  mailStatus   MailStatus @default(PENDING)
  mailError    String?
  avatar       String?
  logoName     String?
  description  String?
  posts        Post[]
  reactions    CommentReaction[]
  commenter    Commenter?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Topic {
  id          String        @id @default(cuid())
  name        String        @db.VarChar(100)
  description String?       @db.Text
  posts       Post[]
  sidebarItems SidebarItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("topics")
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique @db.VarChar(60)
  posts Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tags")
}

model Section {
  id          String @id @default(cuid())
  slug        String @unique
  title       String @db.VarChar(120)
  description String? @db.Text
  topicSlug   String
  idx         Int    @default(0)
  posts       Post[]

  @@map("sections")
}

model SidebarItem {
  id          String        @id @default(cuid())
  name        String        @db.VarChar(120)
  slug        String        @db.VarChar(255)
  description String?
  idx         Int           @default(0)
  parentId    String?
  parent      SidebarItem?  @relation("SidebarTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    SidebarItem[] @relation("SidebarTree")
  topics      Topic[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@map("sidebar_items")
}

model Post {
  id         String     @id @default(cuid())
  title      String     @db.VarChar(200)
  slug       String     @unique
  excerpt    String?    @db.VarChar(500)
  cover      String?
  bodyBlocks Json
  status     PostStatus @default(DRAFT)
  likes      Int        @default(0)
  bookmarks  Int        @default(0)
  sectionId  String?
  section    Section?   @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  authorId   Int
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  topics     Topic[]
  tags       Tag[]
  comments   Comment[]
  postLikes  PostLike[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([status, createdAt])
  @@index([sectionId])
  @@map("posts")
}

model Commenter {
  id              Int               @id @default(autoincrement())
  nickname        String            @db.VarChar(80)
  tokenHash       String            @unique
  userId          Int?              @unique
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  comments        Comment[]
  postLikes       PostLike[]
  commentReactions CommentReaction[]
  commentLikes    CommentLike[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("commenters")
}

model Comment {
  id          String    @id @default(cuid())
  postId      String
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[] @relation("CommentThread")
  commenterId Int
  commenter   Commenter @relation(fields: [commenterId], references: [id], onDelete: Cascade)
  content     String    @db.Text
  isEdited    Boolean   @default(false)
  likes       Int       @default(0)
  reactions   CommentReaction[]
  commentLikes CommentLike[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId, createdAt])
  @@index([parentId])
  @@index([commenterId])
  @@map("comments")
}

model CommentReaction {
  id          String     @id @default(cuid())
  commentId   String
  comment     Comment    @relation(fields: [commentId], references: [id], onDelete: Cascade)
  emoji       String     @db.VarChar(8)
  userId      Int?
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  commenterId Int?
  commenter   Commenter? @relation(fields: [commenterId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@unique([commentId, commenterId, emoji])
  @@map("comment_reactions")
}

model CommentLike {
  id          Int       @id @default(autoincrement())
  commentId   String
  comment     Comment   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commenterId Int
  commenter   Commenter @relation(fields: [commenterId], references: [id], onDelete: Cascade)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@unique([commentId, commenterId])
  @@index([commentId])
  @@index([commenterId])
  @@map("comment_likes")
}

model VisitStat {
  id     Int    @id @default(autoincrement())
  month  String @db.VarChar(7)
  day    Int
  visits Int

  @@unique([month, day])
  @@map("visit_stats")
}

model PostLike {
  id          Int      @id @default(autoincrement())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  commenterId Int
  commenter   Commenter @relation(fields: [commenterId], references: [id], onDelete: Cascade)
  isActive    Boolean  @default(true)

  createdAt DateTime @default(now())

  @@unique([postId, commenterId])
  @@index([postId])
  @@index([commenterId])
  @@map("post_likes")
}

model SocialLink {
  id        Int    @id @default(autoincrement())
  platform  String @db.VarChar(30)
  url       String @db.VarChar(500)
  isActive  Boolean @default(true)
  idx       Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform])
  @@map("social_links")
}

model SiteConfig {
  key       String @id
  value     String @db.Text
  updatedAt DateTime @updatedAt

  @@map("site_configs")
}
