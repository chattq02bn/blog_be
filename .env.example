NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/blog_db?schema=public"

JWT_ACCESS_SECRET=change-me-with-a-long-random-string-min-32-chars
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-me-with-another-long-random-string-min-32-chars
JWT_REFRESH_EXPIRES_IN=30d

CORS_ORIGIN=*
